# --- Supabase (shared project) ----------------------------------------------
# Safe to expose to the browser — these are the public project URL and
# publishable/anon key, not secrets. Supabase dashboard -> Project Settings ->
# API. Used for auth only; these credentials cannot read the finance tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED IN EVERY ENVIRONMENT — this is how the app reads and writes its own
# data. The finance_tracker tables grant nothing to anon/authenticated, so this
# key is the only thing that can reach them (Pattern A; see
# supabase/migrations/finance_tracker_schema.sql).
#
# It bypasses RLS entirely, so treat it as the crown jewels: NEVER prefix it
# NEXT_PUBLIC_, and only ever import it via src/lib/supabase/service.ts, which
# is marked `server-only` so a client-component import fails the build.
#
# Blast radius is full read/WRITE/DELETE, not read-only: the app has edit and
# delete paths, so service_role holds update and delete on both tables. A leak
# can rewrite or destroy history, not just read it.
SUPABASE_SECRET_KEY=

# --- Authorization -----------------------------------------------------------
# Comma-separated Supabase auth user UUIDs allowed to use this app. The Supabase
# project is shared with other apps, so `auth.users` is a shared pool and a valid
# session proves identity, not access.
#
# This is the ONLY authorization gate. Queries reach Postgres as service_role,
# so there is no database backstop behind it — an empty value denies everyone,
# which is the correct failure direction.
#
# Bootstrap it by signing in once and copying the id printed on /login, then
# redeploy. If you sign in with more than one identity, list every UUID.
OWNER_USER_IDS=

# Public origin of this app. Used to build the OAuth redirect URL when
# forwarded headers are absent (local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data source -------------------------------------------------------------
# Local dev only. Always "supabase" (i.e. unset) in production.
# DATA_SOURCE=sqlite

# Absolute path to the old SQLite file. Read when DATA_SOURCE=sqlite, and also
# by `pnpm migrate:sqlite-to-supabase` — that script reads this file directly,
# since a bare tsx script (unlike `next dev`) doesn't load .env.local on its own.
# SQLITE_DB_PATH=

# --- Subscriptions -----------------------------------------------------------
# IANA zone deciding what "today" means when the cron dates a generated charge.
# Defaults to America/Toronto in src/lib/config.ts. The server's own zone is UTC
# on Vercel, which would date charges a day early.
# APP_TIMEZONE=America/Toronto

# Bearer token for GET /api/cron/subscriptions — the ONE route handler that does
# not call requireOwnerForApi(), because a cron invocation carries no session.
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET` once the
# var is set on the project; generate any long random string.
#
# UNSET MEANS THE ENDPOINT IS OFF (503), not open — fail closed, same direction
# as an empty OWNER_USER_IDS. That also means the schedule silently does nothing
# until you set it in Vercel.
CRON_SECRET=

# Resend, for the post-run digest AND the weekly spending report. Server-only —
# never prefix NEXT_PUBLIC_. An email failure is never fatal: receipts are
# written first and the send is swallowed into a log line, so a Resend outage
# cannot affect the ledger. Leaving these unset just skips the notification.
RESEND_API_KEY=
SUBSCRIPTION_EMAIL_TO=
SUBSCRIPTION_EMAIL_FROM=

# --- Spending reports --------------------------------------------------------
# Optional. Where the weekly Saturday report and the on-demand /reports sends go.
# Falls back to SUBSCRIPTION_EMAIL_TO when unset, so this feature needs nothing
# new configured to work — set it only to route reports somewhere else.
# The sender is SUBSCRIPTION_EMAIL_FROM for both email types.
#
# Note APP_TIMEZONE above does double duty now: it decides both what date a
# generated charge carries and what "today" means for a report window, including
# whether the cron thinks it is Saturday.
# REPORT_EMAIL_TO=
