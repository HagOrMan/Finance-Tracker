# --- Supabase (shared project) ----------------------------------------------
# Safe to expose to the browser — these are the public project URL and
# publishable/anon key, not secrets. Supabase dashboard -> Project Settings ->
# API. Used for auth only; these credentials cannot read the finance tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED IN EVERY ENVIRONMENT — this is how the app reads and writes its own
# data. The finance_tracker tables grant nothing to anon/authenticated, so this
# key is the only thing that can reach them (Pattern A; see
# supabase/migrations/finance_tracker_schema.sql).
#
# It bypasses RLS entirely, so treat it as the crown jewels: NEVER prefix it
# NEXT_PUBLIC_, and only ever import it via src/lib/supabase/service.ts, which
# is marked `server-only` so a client-component import fails the build.
SUPABASE_SECRET_KEY=

# --- Authorization -----------------------------------------------------------
# Comma-separated Supabase auth user UUIDs allowed to use this app. The Supabase
# project is shared with other apps, so `auth.users` is a shared pool and a valid
# session proves identity, not access.
#
# This is the ONLY authorization gate. Queries reach Postgres as service_role,
# so there is no database backstop behind it — an empty value denies everyone,
# which is the correct failure direction.
#
# Bootstrap it by signing in once and copying the id printed on /login, then
# redeploy. If you sign in with more than one identity, list every UUID.
OWNER_USER_IDS=

# Public origin of this app. Used to build the OAuth redirect URL when
# forwarded headers are absent (local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data source -------------------------------------------------------------
# Local dev only. Always "supabase" (i.e. unset) in production.
# DATA_SOURCE=sqlite
# SQLITE_DB_PATH=
