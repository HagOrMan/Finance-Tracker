# Supabase (required in all environments)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scripts/migrate-sqlite-to-supabase.ts to bypass RLS
# for the one-time backfill. Never prefix this NEXT_PUBLIC_ and never
# reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Data source toggle — local dev only. Always "supabase" in production.
# DATA_SOURCE=sqlite
# SQLITE_DB_PATH=

# Only needed when running scripts/migrate-sqlite-to-supabase.ts once.
# MIGRATION_USER_ID=
